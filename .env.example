# ==================
# REQUIRED - Slack Configuration
# ==================
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_BOT_USER_NAME=

# ==================
# AI PROVIDER - Choose one
# ==================
# AI Provider: "openai" (default) or "claude"
AI_PROVIDER=openai

# For OpenAI ChatGPT (required if AI_PROVIDER=openai)
OPENAI_API_KEY=

# For Anthropic Claude (required if AI_PROVIDER=claude)
ANTHROPIC_API_KEY=

# ==================
# AUTOMATIC DOCUMENT IMPORT (RECOMMENDED)
# ==================
# Path to your documentation directory
DOCS_PATH=

# Optional: Maximum files to import (default: 500)
DOCS_MAX_FILES=500

# ==================
# OPTIONAL CUSTOMIZATION
# ==================
BOT_PERSONALITY=
THINKING_MESSAGE=
REDIS_URL=redis://localhost:6379
MEMORY_TTL_HOURS=24
MEMORY_MAX_KEYS=10000
